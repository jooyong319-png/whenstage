# Supabase (Vercel Settings → Environment Variables 에 등록)
# Publishable key는 클라이언트 노출 OK (RLS로 보호됨)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# ── 웹 푸시 알림 ──
# VAPID 공개키(클라 노출 OK). 비공개키는 절대 커밋 금지(서버 전용).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:devju546@gmail.com
# cron이 구독 테이블 전체를 읽기 위한 service_role 키(서버 전용, 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# /api/cron/notify 보호용 시크릿(Vercel Cron이 Authorization 헤더로 전송)
CRON_SECRET=YOUR-RANDOM-SECRET


# /admin 대시보드 비밀번호(서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 말 것. 붙이면 브라우저에 노출된다).
# 안 넣으면 관리자 화면이 열리지 않는다. 확인은 app/api/admin/reports 가 한다.
ADMIN_PASS=YOUR-ADMIN-PASSWORD
